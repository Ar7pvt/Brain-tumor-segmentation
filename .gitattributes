# Auto detect text files and normalize line endings to LF in repository
* text=auto

# Source code
*.py text eol=lf
*.ipynb text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Requirements and dependencies
requirements.txt text eol=lf
*.requirements text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts (should use CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (do not normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.hdf5 binary
*.h5 binary
*.pkl binary
*.pickle binary
*.npy binary
*.npz binary
*.zip binary
*.tar binary
*.gz binary
*.tif binary
*.tiff binary
